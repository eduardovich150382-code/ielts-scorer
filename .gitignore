# Kesh — hech qanday keshlangan LLM javobi repo'ga tushmasin
cache/*
!cache/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/

# data/ ichidagi barcha JSON/JSONL ignore, .example.json bundan mustasno
# (golden_set.json, anchors.json, calibration.json, calibration_history.jsonl
#  va h.k. — bularda haqiqiy esse matnlari / bahoyi bor, repo'ga tushmasligi
#  kerak). .jsonl alohida yozilgan — data/*.json glob'i .jsonl'ga mos kelmaydi.
data/*.json
data/*.jsonl
!data/*.example.json

# API kalitlari / mahalliy sozlamalar (.env.example bundan mustasno — u shablon,
# sirlar emas, repo'da bo'lishi kerak)
.env
.env.*
!.env.example

# Strategiya/moliya/marketing hujjatlari — mahalliy, repo public bo'lgani uchun
# hech qachon push qilinmasin
docs/
