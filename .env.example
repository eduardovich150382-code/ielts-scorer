# Nusxalab .env nomi bilan saqlang, keyin haqiqiy qiymatlarni kiriting.
# .env fayli .gitignore'da — hech qachon commit qilinmaydi.

# LLM provayder: "anthropic" yoki "gemini". Bo'sh qoldirilsa — anthropic.
# Faqat TANLAGAN provayderning kalitini to'ldirish kifoya (ikkalasi ham
# majburiy emas). config.py: LLM_PROVIDER.
LLM_PROVIDER=gemini

# @BotFather'dan olinadi (Telegram'da /newbot)
BOT_TOKEN=

# LLM_PROVIDER=anthropic bo'lsa kerak (llm.py: _get_anthropic_client).
ANTHROPIC_API_KEY=

# LLM_PROVIDER=gemini bo'lsa kerak (llm.py: _get_gemini_client).
# https://aistudio.google.com/apikey'dan olinadi.
GEMINI_API_KEY=

# Mahalliy: docker-compose.yml'dagi standart qiymatlar bilan mos.
# Muqobil (Docker'siz): Neon yoki Supabase free tier DSN'ini shu yerga qo'ying.
DATABASE_URL=postgresql://ielts:ielts@localhost:5432/ielts_bot
